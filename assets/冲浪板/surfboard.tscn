[sub_resource type="Shader" id="Shader_g7sea"]
code = "
shader_type spatial;
varying vec3 on_pad;
void vertex() {
	on_pad = VERTEX;
}
void fragment() {
	vec2 pattern = vec2(on_pad.x + on_pad.z, on_pad.z - on_pad.x) / 0.009;
	vec2 grooves = abs(fract(pattern) - 0.5);
	float cut = smoothstep(0.30, 0.47, max(grooves.x, grooves.y));
	cut = mix(cut, 0.45, smoothstep(0.10, 0.55, max(fwidth(pattern.x), fwidth(pattern.y))));
	ALBEDO = mix(vec3(0.024, 0.044, 0.047), vec3(0.011, 0.019, 0.021), cut);
	ROUGHNESS = 0.96;
	SPECULAR = 0.16;
}
"

