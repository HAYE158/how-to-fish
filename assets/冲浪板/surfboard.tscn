[gd_scene format=4]

[sub_resource type="Shader" id="Shader_qg8uw"]
code = "
shader_type spatial;
varying vec3 position_on_board;
varying float deck_normal;
uniform vec4 ivory : source_color = vec4(0.96, 0.91, 0.81, 1.0);
uniform vec4 teal : source_color = vec4(0.05, 0.51, 0.52, 1.0);
uniform vec4 deep_teal : source_color = vec4(0.027, 0.23, 0.27, 1.0);
uniform vec4 orange : source_color = vec4(0.96, 0.37, 0.18, 1.0);
uniform vec4 wood : source_color = vec4(0.69, 0.45, 0.27, 1.0);

void vertex() {
	position_on_board = VERTEX;
	deck_normal = NORMAL.y;
}

void fragment() {
	float x = position_on_board.x;
	float z = position_on_board.z;
	float stripe = z + 0.66 * x;
	float edge = fwidth(stripe) * 0.75 + 0.0007;
	vec3 deck = mix(ivory.rgb, orange.rgb, smoothstep(0.262 - edge, 0.262 + edge, stripe));
	deck = mix(deck, ivory.rgb, smoothstep(0.334 - edge, 0.334 + edge, stripe));
	deck = mix(deck, teal.rgb, smoothstep(0.378 - edge, 0.378 + edge, stripe));
	deck = mix(deck, deep_teal.rgb, smoothstep(0.660, 0.836, z));
	vec3 bottom = mix(teal.rgb, deep_teal.rgb, smoothstep(-0.20, 0.9, z));
	float accents = smoothstep(-0.62 - edge, -0.62 + edge, stripe) *
		(1.0 - smoothstep(-0.351 - edge, -0.351 + edge, stripe));
	bottom = mix(bottom, ivory.rgb, accents);
	float hot = smoothstep(-0.351 - edge, -0.351 + edge, stripe) *
		(1.0 - smoothstep(-0.307 - edge, -0.307 + edge, stripe));
	bottom = mix(bottom, orange.rgb, hot);
	float deck_fade = smoothstep(0.03, 0.51, deck_normal);
	vec3 color = mix(bottom, deck, deck_fade);
	float grain_width = max(0.0007, fwidth(x) * 0.5);
	float centerline = 1.0 - smoothstep(0.0018 - grain_width, 0.0018 + grain_width, abs(x));
	vec3 cedar = wood.rgb * (0.92 + sin(z * 116.0 + 1.5 * sin(z * 35.0)) * 0.08);
	color = mix(color, cedar, centerline * smoothstep(0.35, 0.83, abs(deck_normal)));
	float weave = sin(1960.0 * x + 1850.0 * z) * sin(1930.0 * z - 1610.0 * x);
	float detail = 1.0 - smoothstep(0.00012, 0.00057, max(fwidth(x), fwidth(z)));
	ALBEDO = color * (1.0 + weave * detail * 0.035);
	ROUGHNESS = 0.26 + weave * detail * 0.04;
	SPECULAR = 0.37;
	CLEARCOAT = 0.24;
	CLEARCOAT_ROUGHNESS = 0.27;
}
"

