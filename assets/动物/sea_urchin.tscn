[gd_scene format=4]

[sub_resource type="Shader" id="Shader_oafxe"]
code = "
shader_type spatial;
render_mode diffuse_burley, specular_disabled;
varying vec3 coat_position;
uniform vec4 base_coat : source_color;
uniform vec4 top_coat : source_color;
uniform float boundary;
uniform float fade;
void vertex() {
	coat_position = VERTEX;
}
void fragment() {
	float line = coat_position.y + 0.115 * (1.0 - abs(coat_position.z))
		+ 0.042 * sin(coat_position.z * 7.0 + coat_position.x * 3.0);
	ALBEDO = mix(base_coat.rgb, top_coat.rgb, smoothstep(boundary - fade, boundary + fade, line));
	ROUGHNESS = 1.0;
	SPECULAR = 0.0;
}
"

