shader_parameter/base_coat = Color(0.4509804, 0.3137255, 0.47058824, 1)
shader_parameter/top_coat = Color(0.29803923, 0.23529412, 0.40392157, 1)
shader_parameter/boundary = 0.05
shader_parameter/fade = 0.5

